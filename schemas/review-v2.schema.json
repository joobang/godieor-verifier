{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GODIEOR independent review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PENDING",
        "ERROR"
      ]
    },
    "app_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "reproduction": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "requirement_id",
          "severity",
          "evidence",
          "reproduction",
          "uncertainty"
        ]
      }
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "status",
    "app_head_sha",
    "acceptance_sha256",
    "model",
    "settings",
    "started_at",
    "finished_at",
    "findings",
    "subject_sha256",
    "run_id"
  ]
}
